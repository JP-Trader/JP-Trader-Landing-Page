# Web3Forms access key (https://web3forms.com, free). Inquiries are emailed straight to
# the address the key was created for (info@jptrader.in). Takes priority over VITE_FORM_ENDPOINT.
VITE_WEB3FORMS_KEY=

# Alternative: any endpoint that accepts a JSON POST { name, email, phone, service, message }
# (Formspree, a serverless function, or your own API).
VITE_FORM_ENDPOINT=

# If neither is set, the form falls back to opening the visitor's email client addressed to info@jptrader.in.
